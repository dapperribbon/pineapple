# Copy to `.env` in this directory to change the defaults.

# Interface the lab is published on. 127.0.0.1 (the default) means only this
# host can reach it; use the lab NIC's address for a classroom, or 0.0.0.0 to
# publish on every interface. Never point this at a public interface.
SIWANG_BIND=127.0.0.1

# Only consulted when /var/lib/mysql is an empty mounted volume, i.e. when the
# entrypoint has to re-provision the database. Leave unset to have a random
# 28-character password generated, as the VM installer does.
#SIWANG_DB_PASS=
